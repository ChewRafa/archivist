SESSION_SECRET=
DATABASE_URL=
GIN_MODE=
PORT=
DB_PATH=data/archivist.db
ADMIN_USERNAME=
ADMIN_PASSWORD=
# ADMIN_USERNAME/ADMIN_PASSWORD: initial admin seed on server start.
# If the user is missing it is created; if it already exists its password is
# reset from the env vars on every boot (useful to recover a lost password on
# Render). Unset/remove both after the first successful login for security.
# Render render.yaml sets ADMIN_USERNAME=admin and generates ADMIN_PASSWORD.
# DATABASE_URL: on Render injected from archivist-db via fromDatabase in
# render.yaml (uses PostgreSQL); locally leave empty to use SQLite at DB_PATH.
